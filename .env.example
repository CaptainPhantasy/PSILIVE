# ===========================================
# PRECISION SEWER INSPECTION - ENVIRONMENT VARIABLES
# Migration Template for Hostinger or Self-Hosting
# ===========================================

# -----------------------------------------
# DATABASE (Required)
# -----------------------------------------
# Create a PostgreSQL database on Hostinger or use a service like:
# - Hostinger's MySQL/PostgreSQL (if available)
# - PlanetScale, Supabase, Neon, or Railway for managed PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL='postgresql://your_username:your_password@your_host:5432/your_database'

# -----------------------------------------
# AUTHENTICATION (Required)
# -----------------------------------------
# Generate a secure random string for NextAuth
# Run: openssl rand -base64 32
NEXTAUTH_SECRET='generate-a-32-character-random-string-here'

# Your production domain (no trailing slash)
NEXTAUTH_URL='https://precisionsewerinspection.com'

# Required only when admin-created users omit an explicit initial password.
# Use a unique high-entropy value in each deployed environment; never commit the real value.
DEFAULT_INITIAL_PASSWORD='replace-with-secure-temporary-password'

# -----------------------------------------
# FILE STORAGE - AWS S3 (Required for video uploads)
# -----------------------------------------
# Create an S3 bucket on AWS or use alternatives like:
# - DigitalOcean Spaces
# - Backblaze B2
# - Cloudflare R2
# - MinIO (self-hosted)
AWS_ACCESS_KEY_ID='your-aws-access-key'
AWS_SECRET_ACCESS_KEY='your-aws-secret-key'
AWS_REGION='us-east-1'
AWS_BUCKET_NAME='your-bucket-name'
AWS_FOLDER_PREFIX='uploads/'

# -----------------------------------------
# AI CHAT FEATURE (Optional - remove if not using)
# -----------------------------------------
# Option 1: Use OpenAI directly
OPENAI_API_KEY='sk-your-openai-api-key'

# Option 2: Keep using Abacus AI (if subscription continues)
# ABACUSAI_API_KEY='your-abacus-api-key'

# -----------------------------------------
# EMAIL NOTIFICATIONS (Required for contact form & alerts)
# -----------------------------------------
# Choose ONE email provider:

# Option A: SendGrid
SENDGRID_API_KEY='SG.your-sendgrid-api-key'
EMAIL_FROM='noreply@precisionsewerinspection.com'
ADMIN_EMAIL='admin@precisionsewerinspection.com'

# Option B: Mailgun
# MAILGUN_API_KEY='your-mailgun-key'
# MAILGUN_DOMAIN='mg.precisionsewerinspection.com'

# Option C: SMTP (Hostinger email)
# SMTP_HOST='smtp.hostinger.com'
# SMTP_PORT='465'
# SMTP_USER='noreply@precisionsewerinspection.com'
# SMTP_PASSWORD='your-email-password'

# -----------------------------------------
# PDF GENERATION (Required for inspection reports)
# -----------------------------------------
# Option 1: Use a PDF API service like:
# - Puppeteer/Playwright (requires Node.js server)
# - PDFShift, DocRaptor, or similar API
# HTML2PDF_API_URL='https://api.pdfshift.io/v3/convert/pdf'
# HTML2PDF_API_KEY='your-pdf-api-key'

# Option 2: Self-host with Puppeteer
# (Requires server that supports headless Chrome)

# -----------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# -----------------------------------------
# GOOGLE_ANALYTICS_ID='G-XXXXXXXXXX'
# SENTRY_DSN='https://xxx@sentry.io/xxx'

# ===========================================
# MIGRATION CHECKLIST
# ===========================================
# 1. [ ] Set up PostgreSQL database and update DATABASE_URL
# 2. [ ] Run: npx prisma migrate deploy (to create tables)
# 3. [ ] Run: npx prisma db seed (to create admin/tech users)
# 4. [ ] Set up S3 bucket with proper CORS configuration
# 5. [ ] Configure email provider (SendGrid/Mailgun/SMTP)
# 6. [ ] Set up PDF generation service
# 7. [ ] Generate NEXTAUTH_SECRET
# 8. [ ] Update NEXTAUTH_URL to your domain
# 9. [ ] (Optional) Set up OpenAI for AI chat
# 10. [ ] Test all features: login, contact form, video upload

# ===========================================
# S3 CORS CONFIGURATION (Required)
# ===========================================
# Add this CORS policy to your S3 bucket:
# [
#   {
#     "AllowedHeaders": ["*"],
#     "AllowedMethods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
#     "AllowedOrigins": ["https://precisionsewerinspection.com"],
#     "ExposeHeaders": ["ETag"]
#   }
# ]

# ===========================================
# NOTES FOR HOSTINGER DEPLOYMENT
# ===========================================
# - Hostinger VPS/Cloud: Can run Next.js with Node.js
# - Hostinger Shared Hosting: NOT compatible (no Node.js)
# - Consider using Vercel, Railway, or Render for easier Next.js deployment
# - If using Hostinger VPS, install Node.js 18+ and PM2 for process management
